Cell["fRG setup and truncation", "Chapter",
 CellChangeTimes->{
  3.988356166773622*^9},ExpressionUUID->"691431c0-721a-412a-86c6-\
8218862e3e27"],

Cell["\<\
The  fRG  flow  equation  for  QMeS  and  the  truncation  for  the  scalar  \
sector .  For the potential we only need the propagators, two-point functions \
and regulators:\
\>", "Text",
 CellChangeTimes->{{3.988356177422763*^9, 
  3.9883562132845488`*^9}},ExpressionUUID->"ae06a5a5-7d96-48f3-93ac-\
3833a862c281"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fields", "=", " ", 
   RowBox[{"<|", 
    RowBox[{"\"\<Commuting\>\"", "\[Rule]", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Sigma]", "[", "p", "]"}], ",", 
       RowBox[{"\[CapitalPi]", "[", 
        RowBox[{"p", ",", 
         RowBox[{"{", "a", "}"}]}], "]"}]}], "}"}]}], "|>"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"truncation", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"GammaN", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Sigma]", ",", "\[Sigma]"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[CapitalPi]", ",", "\[CapitalPi]"}], "}"}]}], "}"}]}], ",",
      "\[IndentingNewLine]", "\t", 
     RowBox[{"Propagator", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Sigma]", ",", "\[Sigma]"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[CapitalPi]", ",", "\[CapitalPi]"}], "}"}]}], "}"}]}], ",",
      "\[IndentingNewLine]", "\t", 
     RowBox[{"Rdot", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Sigma]", ",", "\[Sigma]"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[CapitalPi]", ",", "\[CapitalPi]"}], "}"}]}], "}"}]}], ",",
      "\n", "\t", 
     RowBox[{"R", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Sigma]", ",", "\[Sigma]"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[CapitalPi]", ",", "\[CapitalPi]"}], "}"}]}], "}"}]}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bases", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"GammaN", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[CapitalPi]", ",", "\[CapitalPi]"}], "}"}], "->", 
          "\"\<\[CapitalPi]\[CapitalPi]\>\""}], ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Sigma]", ",", "\[Sigma]"}], "}"}], "->", 
          "\"\<\[Sigma]\[Sigma]\>\""}]}], "}"}]}], ",", "\[IndentingNewLine]",
       "\t", 
      RowBox[{"Propagator", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[CapitalPi]", ",", "\[CapitalPi]"}], "}"}], "->", 
          "\"\<\[CapitalPi]\[CapitalPi]\>\""}], ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Sigma]", ",", "\[Sigma]"}], "}"}], "->", 
          "\"\<\[Sigma]\[Sigma]\>\""}]}], "}"}]}], ",", "\[IndentingNewLine]",
       "\t", 
      RowBox[{"R", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[CapitalPi]", ",", "\[CapitalPi]"}], "}"}], "->", 
          "\"\<\[CapitalPi]\[CapitalPi]\>\""}], ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Sigma]", ",", "\[Sigma]"}], "}"}], "->", 
          "\"\<\[Sigma]\[Sigma]\>\""}]}], "}"}]}], ",", "\[IndentingNewLine]",
       "\t", 
      RowBox[{"Rdot", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[CapitalPi]", ",", "\[CapitalPi]"}], "}"}], "->", 
          "\"\<\[CapitalPi]\[CapitalPi]\>\""}], ",", 
