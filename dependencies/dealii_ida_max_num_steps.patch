diff --git a/include/deal.II/sundials/ida.h b/include/deal.II/sundials/ida.h
index 78b2f21..44ca63c 100644
--- a/include/deal.II/sundials/ida.h
+++ b/include/deal.II/sundials/ida.h
@@ -610,4 +610,22 @@ namespace SUNDIALS
     /**
      * Destructor.
      */
     ~IDA();
+    struct Statistics
+    {
+      bool valid = false;
+      long int num_steps = 0;
+      long int num_residual_evaluations = 0;
+      long int num_linear_solver_setups = 0;
+      long int num_error_test_failures = 0;
+      long int num_nonlinear_iterations = 0;
+      long int num_nonlinear_convergence_failures = 0;
+      long int num_step_solve_failures = 0;
+      double last_step_size = 0.;
+      double current_step_size = 0.;
+      double current_time = 0.;
+    };
+    Statistics
+    get_statistics() const;
diff --git a/source/sundials/ida.cc b/source/sundials/ida.cc
index 2c66cf8..38eb0a7 100644
--- a/source/sundials/ida.cc
+++ b/source/sundials/ida.cc
@@ -40,2 +40,3 @@
 #  include <iomanip>
 #  include <iostream>
+#  include <limits>
@@ -158,10 +159,45 @@ namespace SUNDIALS
   template <typename VectorType>
   IDA<VectorType>::~IDA()
   {
     IDAFree(&ida_mem);
 #  if DEAL_II_SUNDIALS_VERSION_GTE(6, 0, 0)
     const int status = SUNContext_Free(&ida_ctx);
     (void)status;
     AssertIDA(status);
 #  endif
   }
+  template <typename VectorType>
+  typename IDA<VectorType>::Statistics
+  IDA<VectorType>::get_statistics() const
+  {
+    Statistics statistics;
+    if (ida_mem == nullptr)
+      return statistics;
+    statistics.valid = true;
+    int status = IDAGetNumSteps(ida_mem, &statistics.num_steps);
+    statistics.valid = statistics.valid && status >= 0;
+    status = IDAGetNumResEvals(ida_mem, &statistics.num_residual_evaluations);
+    statistics.valid = statistics.valid && status >= 0;
+    status = IDAGetNumLinSolvSetups(ida_mem, &statistics.num_linear_solver_setups);
+    statistics.valid = statistics.valid && status >= 0;
+    status = IDAGetNumErrTestFails(ida_mem, &statistics.num_error_test_failures);
+    statistics.valid = statistics.valid && status >= 0;
+    status = IDAGetNumNonlinSolvIters(ida_mem, &statistics.num_nonlinear_iterations);
+    statistics.valid = statistics.valid && status >= 0;
+    status = IDAGetNumNonlinSolvConvFails(
+      ida_mem, &statistics.num_nonlinear_convergence_failures);
+    statistics.valid = statistics.valid && status >= 0;
+    status =
+      IDAGetNumStepSolveFails(ida_mem, &statistics.num_step_solve_failures);
+    statistics.valid = statistics.valid && status >= 0;
+    status = IDAGetLastStep(ida_mem, &statistics.last_step_size);
+    statistics.valid = statistics.valid && status >= 0;
+    status = IDAGetCurrentStep(ida_mem, &statistics.current_step_size);
+    statistics.valid = statistics.valid && status >= 0;
+    status = IDAGetCurrentTime(ida_mem, &statistics.current_time);
+    statistics.valid = statistics.valid && status >= 0;
+    return statistics;
+  }
@@ -329 +365,2 @@ namespace SUNDIALS
-    //  status = IDASetMaxNumSteps(ida_mem, max_steps);
+    status = IDASetMaxNumSteps(ida_mem, std::numeric_limits<long int>::max());
+    AssertIDA(status);
