Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dressingRules", " ", "=", " ", 
    RowBox[{"{", "\n", "\t", 
     RowBox[{"(*", "propagators", "*)"}], "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"dressing", "[", 
