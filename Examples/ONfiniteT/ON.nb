Cell[BoxData[{
 RowBox[{
  RowBox[{"AddGroupTensors", "[", 
   RowBox[{"{", 
    RowBox[{"SONfund", ",", 
     RowBox[{"{", 
      RowBox[{"SONm1", ",", " ", 
       RowBox[{"Nf", "-", "1"}]}], "}"}], ",", 
     RowBox[{"deltaadjSONm1", "[", 
